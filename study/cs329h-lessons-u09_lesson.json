  {
   "anchor": "cs329h-u09-c09-normative-choices",
   "title": "cs329h-U09-C09: normative choices",
   "minutes": 2,
   "endAnchor": "cs329h-u09-c09-normative-choices-end",
   "blocks": [
    {
     "anchor": "cs329h-u09-c09-normative-choices-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "cs329h-u09-c09-normative-choices-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "normative choices",
     "definition": "Whose ballots count, how they are weighted, what the rule maximizes; they cannot be derived from the ballots.",
     "anchor": "cs329h-u09-c09-normative-choices-p01"
    },
    {
     "term": "values",
     "definition": "Baked into every aggregation; they cannot be derived from the ballots.",
     "anchor": "cs329h-u09-c09-normative-choices-p03"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u09-c09-normative-choices-r1",
     "question": "What are three defensible designs?",
     "answer": "Plurality for simplicity, Borda for consensus, Condorcet for pairwise legitimacy.",
     "anchor": "cs329h-u09-c09-normative-choices-p06"
    },
    {
     "id": "cs329h-u09-c09-normative-choices-r2",
     "question": "What is the after-the-fact failure?",
     "answer": "The memo rationalizes the winner; the rule changes each election to suit the incumbent.",
     "anchor": "cs329h-u09-c09-normative-choices-p11"
    }
   ]
  },
