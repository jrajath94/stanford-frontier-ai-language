   "keyTerms": [
    {
     "term": "literature review",
     "definition": "Finds the closest published methods, re-derives their key result, implements the simplest one.",
     "anchor": "cs329h-u10-c02-literature-review-p03"
    },
    {
     "term": "strongest baseline",
     "definition": "What your contribution is measured against, not the weakest.",
