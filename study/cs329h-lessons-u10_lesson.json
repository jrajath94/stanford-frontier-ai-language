    }
   ],
   "recall": [
    {
     "id": "cs329h-u10-c02-literature-review-r1",
     "question": "What is the worked example?",
     "answer": "Dueling bandits: learn the best arm from pairwise comparisons; TS achieves low regret; Bradley-Terry simulator, 4 arms.",
     "anchor": "cs329h-u10-c02-literature-review-p05"
    },
    {
     "id": "cs329h-u10-c02-literature-review-r2",
     "question": "What is a misread baseline?",
     "answer": "Comparing cumulative regret to simple regret.",
     "anchor": "cs329h-u10-c02-literature-review-p11"
    }
   ]
