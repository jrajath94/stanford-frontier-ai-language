   ],
   "keyTerms": [
    {
     "term": "acquisition function",
     "definition": "Turns the posterior into a shopping list.",
     "anchor": "cs329h-u07-c03-acquisition-functions-p03"
    },
    {
     "term": "UCB",
     "definition": "Optimistic: mu + k*sd.",
     "anchor": "cs329h-u07-c03-acquisition-functions-p01"
    },
    {
     "term": "EI",
     "definition": "The expected gain over the best so far, with a closed form under Gaussian posteriors.",
     "anchor": "cs329h-u07-c03-acquisition-functions-p01"
    },
    {
     "term": "PI",
     "definition": "The chance of any gain.",
     "anchor": "cs329h-u07-c03-acquisition-functions-p01"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u07-c03-acquisition-functions-r1",
     "question": "What are the toy scores?",
     "answer": "UCB(k=2): 1.40, 1.90, 2.10. EI: 0.201, 0.153, 0.130. PI: 0.977, 0.421, 0.266.",
     "anchor": "cs329h-u07-c03-acquisition-functions-p06"
    },
    {
     "id": "cs329h-u07-c03-acquisition-functions-r2",
     "question": "When do the scores misrank?",
     "answer": "When the Gaussian posterior is wrong; heavy-tailed truth makes UCB with small k under-explore.",
     "anchor": "cs329h-u07-c03-acquisition-functions-p11"
    }
   ]
  },
