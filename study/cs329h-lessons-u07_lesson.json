    {
     "anchor": "cs329h-u07-c01-posterior-sampling-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "Thompson sampling",
     "definition": "Sample a world from the posterior, then act as if the sample were true.",
     "anchor": "cs329h-u07-c01-posterior-sampling-p01"
    },
    {
     "term": "probability matching",
     "definition": "P(pull a) = P(a is optimal | data); no epsilon to tune.",
     "anchor": "cs329h-u07-c01-posterior-sampling-p05"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u07-c01-posterior-sampling-r1",
     "question": "How often does TS pull arm 1 on the toy?",
     "answer": "About 0.850, the posterior probability that arm 1 is best.",
     "anchor": "cs329h-u07-c01-posterior-sampling-p06"
    },
    {
     "id": "cs329h-u07-c01-posterior-sampling-r2",
     "question": "When does TS fail?",
     "answer": "With a misspecified posterior; TS confidently pulls a bad arm.",
     "anchor": "cs329h-u07-c01-posterior-sampling-p11"
    }
   ]
  },
  {
