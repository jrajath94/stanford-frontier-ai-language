  {
   "anchor": "cs329h-u07-c09-noisy-utility",
   "title": "cs329h-U07-C09: noisy utility",
   "minutes": 2,
   "endAnchor": "cs329h-u07-c09-noisy-utility-end",
   "blocks": [
    {
     "anchor": "cs329h-u07-c09-noisy-utility-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "cs329h-u07-c09-noisy-utility-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "noisy utility",
     "definition": "U_i = u_i + eps_i; the winner is the argmax of noisy utilities.",
     "anchor": "cs329h-u07-c09-noisy-utility-p03"
    },
    {
     "term": "noise floor",
     "definition": "Bounds learning: no policy identifies the best arm faster than the noise allows.",
     "anchor": "cs329h-u07-c09-noisy-utility-p05"
    },
    {
     "term": "irreducible error",
     "definition": "Even the true best arm loses sometimes.",
     "anchor": "cs329h-u07-c09-noisy-utility-p03"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u07-c09-noisy-utility-r1",
     "question": "Gap 0.4: single duel versus majority of 9?",
     "answer": "0.599 versus 0.731.",
     "anchor": "cs329h-u07-c09-noisy-utility-p06"
    },
    {
     "id": "cs329h-u07-c09-noisy-utility-r2",
     "question": "When does 1/sqrt(n) averaging break?",
     "answer": "When noise is not IID; later duels noisier makes the majority vote mislead.",
     "anchor": "cs329h-u07-c09-noisy-utility-p11"
    }
   ]
  },
  {
   "anchor": "cs329h-u07-c10-stopping",
