   "title": "U07 interview key",
   "minutes": 1,
   "endAnchor": "u07-interview-key-end",
   "blocks": [
    {
     "anchor": "u07-interview-key-p01",
     "kind": "keyIdea",
     "reveal": "rise"
    }
   ],
   "keyTerms": [
    {
     "term": "strong answer",
     "definition": "The minimum sufficient explanation that earns full marks.",
     "anchor": "u07-interview-key-p01"
    },
    {
     "term": "red flag",
     "definition": "A common wrong answer that signals a misconception.",
     "anchor": "u07-interview-key-p01"
    },
    {
     "term": "rubric",
     "definition": "The scoring breakdown per question part.",
     "anchor": "u07-interview-key-p01"
    },
    {
     "term": "remediation",
     "definition": "The lesson reference to revisit after a miss.",
     "anchor": "u07-interview-key-p01"
    },
    {
     "term": "closed-book",
     "definition": "Answering from memory with no notes, books, or key open.",
     "anchor": "u07-interview-key-p01"
    }
   ],
   "recall": [
    {
     "id": "u07-interview-key-r1",
     "question": "What five parts does each U07 key entry carry?",
     "answer": "Minimum sufficient explanation, strong answer, red flags, scoring rubric, and remediation.",
     "anchor": "u07-interview-key-p01"
    },
    {
     "id": "u07-interview-key-r2",
     "question": "How should you use the key?",
     "answer": "Keep it closed-book: attempt first, then check.",
     "anchor": "u07-interview-key-p01"
    }
   ]
  },
  {
   "anchor": "breadth",
   "title": "Breadth",
   "minutes": 1,
   "endAnchor": "breadth-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "H/R",
     "definition": "Recall: the fraction of relevant docs found.",
     "anchor": "breadth-list01"
    },
    {
     "term": "H/K",
     "definition": "Precision: the fraction of retrieved docs relevant.",
     "anchor": "breadth-list01"
    },
    {
     "term": "alpha",
     "definition": "The fusion weight; unnormalized scales eat it.",
     "anchor": "breadth-list01"
    },
    {
     "term": "joint scoring",
     "definition": "The reranker's (query, doc) scoring; accurate but slow.",
     "anchor": "breadth-list01"
    },
    {
     "term": "trace",
     "definition": "The short-lived store of agent steps.",
     "anchor": "breadth-list01"
    },
    {
     "term": "profile",
     "definition": "The durable store of user facts.",
     "anchor": "breadth-list01"
    }
   ],
   "recall": [
    {
     "id": "breadth-r1",
     "question": "What is the B1 red flag?",
     "answer": "Swapping recall and precision.",
     "anchor": "breadth-list01"
    },
    {
     "id": "breadth-r2",
     "question": "What is the B3 red flag?",
     "answer": "Saying the reranker improves recall.",
     "anchor": "breadth-list01"
    },
    {
     "id": "breadth-r3",
     "question": "What three guards does strong B6 name?",
     "answer": "Step cap, no-repeat rule, answer trigger.",
     "anchor": "breadth-list01"
    }
   ]
  },
  {
   "anchor": "deep-ladders",
   "title": "Deep ladders",
   "minutes": 1,
   "endAnchor": "deep-ladders-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "fused ranks",
     "definition": "[0.65, 0.60]; doc 1 wins.",
     "anchor": "deep-ladders-list01"
    },
    {
     "term": "decoration",
     "definition": "Thoughts that do not guide actions.",
     "anchor": "deep-ladders-list01"
    },
    {
     "term": "no-action check",
     "definition": "Thought without Action twice means stuck.",
     "anchor": "deep-ladders-list01"
    }
   ],
   "recall": [
    {
     "id": "deep-ladders-r1",
     "question": "What does BM25-always-wins mean?",
     "answer": "Unnormalized scales.",
     "anchor": "deep-ladders-list01"
    },
    {
     "id": "deep-ladders-r2",
     "question": "What does 6 Thoughts 0 Actions mean?",
     "answer": "The trigger format is broken or the model avoids acting.",
     "anchor": "deep-ladders-list01"
    }
   ]
  },
  {
   "anchor": "analytical-exercises",
   "title": "Analytical exercises",
   "minutes": 1,
   "endAnchor": "analytical-exercises-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "binding constraint",
     "definition": "precision@5, not recall@k.",
     "anchor": "analytical-exercises-list01"
    },
    {
     "term": "ship A",
     "definition": "Same final quality at half the retrieval cost.",
     "anchor": "analytical-exercises-list01"
    },
    {
     "term": "reserve",
     "definition": "The 800 tokens the E2 red flag forgets.",
     "anchor": "analytical-exercises-list01"
    }
   ],
   "recall": [
    {
     "id": "analytical-exercises-r1",
     "question": "Why ship A?",
     "answer": "Same final quality at half the retrieval cost.",
     "anchor": "analytical-exercises-list01"
    },
    {
     "id": "analytical-exercises-r2",
     "question": "How many docs fit fully in E2?",
     "answer": "Two full docs plus 600 tokens of the third.",
     "anchor": "analytical-exercises-list01"
    }
   ]
  },
  {
   "anchor": "implementationdebug-task",
   "title": "Implementation/debug task",
   "minutes": 1,
   "endAnchor": "implementationdebug-task-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "repeat guard",
     "definition": "The no-repeat rule that stops the loop.",
     "anchor": "implementationdebug-task-list01"
    },
    {
     "term": "dedup",
     "definition": "Result diversity so search stops returning the same hits.",
     "anchor": "implementationdebug-task-list01"
    },
    {
     "term": "max_steps",
     "definition": "The config cap, here 10.",
     "anchor": "implementationdebug-task-list01"
    }
   ],
   "recall": [
    {
     "id": "implementationdebug-task-r1",
     "question": "What is the D1 culprit?",
     "answer": "No repeat guard plus a search tool returning the same results.",
     "anchor": "implementationdebug-task-list01"
    },
    {
     "id": "implementationdebug-task-r2",
     "question": "What three config lines must the answer write?",
     "answer": "max_steps 10, no_repeat true, answer_trigger set.",
     "anchor": "implementationdebug-task-list01"
    }
   ]
  },
