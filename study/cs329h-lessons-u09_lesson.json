    }
   ],
   "recall": [
    {
     "id": "cs329h-u09-c06-interpersonal-comparison-r1",
     "question": "How does rescaling flip the verdict?",
     "answer": "Raw sums A=100, B=1: landslide. Normalized: A=1, B=1: tie.",
     "anchor": "cs329h-u09-c06-interpersonal-comparison-p05"
    },
    {
     "id": "cs329h-u09-c06-interpersonal-comparison-r2",
     "question": "What does a fiat scale do?",
     "answer": "The outcome reflects the scale choice; 0-10 vs 0-100 elicitation flips a close sum.",
     "anchor": "cs329h-u09-c06-interpersonal-comparison-p11"
    }
   ]
