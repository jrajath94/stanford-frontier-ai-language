  {
   "anchor": "cs329h-u07-c01-posterior-sampling",
   "title": "cs329h-U07-C01: posterior sampling",
   "minutes": 2,
   "endAnchor": "cs329h-u07-c01-posterior-sampling-end",
   "blocks": [
    {
     "anchor": "cs329h-u07-c01-posterior-sampling-p03",
     "kind": "keyIdea",
     "reveal": "rise"
