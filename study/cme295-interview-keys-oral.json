   "endAnchor": "d1-attention-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "attention formula",
     "definition": "softmax(QK^T/sqrt(d))V, weights over values.",
     "anchor": "d1-attention-list01"
    },
    {
     "term": "O(n^2 d)",
     "definition": "Attention time; O(n^2) memory.",
     "anchor": "d1-attention-list01"
    },
    {
     "term": "permutation invariant",
     "definition": "Without positions, order means nothing.",
     "anchor": "d1-attention-list01"
    }
   ],
   "recall": [
    {
     "id": "d1-attention-r1",
     "question": "What are the rung-2 rows?",
     "answer": "[0.731, 0.269] and [0.269, 0.731].",
     "anchor": "d1-attention-list01"
    },
    {
     "id": "d1-attention-r2",
     "question": "What does rung 8 sweep?",
     "answer": "The scale in {1, sqrt(d), d} on a toy copy task.",
     "anchor": "d1-attention-list01"
    }
   ]
