   ],
   "keyTerms": [
    {
     "term": "information aggregation",
     "definition": "Voters share a common goal but get noisy signals.",
     "anchor": "cs329h-u09-c07-information-aggregation-p03"
    },
    {
     "term": "Condorcet jury theorem",
     "definition": "Majority vote can beat any individual.",
     "anchor": "cs329h-u09-c07-information-aggregation-p03"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u09-c07-information-aggregation-r1",
     "question": "What are the jury numbers?",
     "answer": "n = 5, p = 0.6: 0.6826. n = 101: 0.9791.",
     "anchor": "cs329h-u09-c07-information-aggregation-p05"
    },
    {
     "id": "cs329h-u09-c07-information-aggregation-r2",
     "question": "When is the crowd confidently wrong?",
     "answer": "With correlated errors; all voters watching the same misleading news gives p effectively 0.4.",
     "anchor": "cs329h-u09-c07-information-aggregation-p11"
    }
   ]
  },
