  {
   "anchor": "local-remediation-voting-rules-strategyproofness-pareto",
   "title": "Local remediation: voting rules, strategyproofness, Pareto",
   "minutes": 1,
   "endAnchor": "local-remediation-voting-rules-strategyproofness-pareto-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "voting rules",
     "definition": "Plurality, Borda, and Condorcet; different rules give different winners from the same ballots.",
     "anchor": "local-remediation-voting-rules-strategyproofness-pareto-p01"
    },
    {
     "term": "strategyproofness",
     "definition": "No voter can get a better outcome by misreporting.",
     "anchor": "local-remediation-voting-rules-strategyproofness-pareto-p02"
    },
    {
     "term": "Pareto",
     "definition": "Outcome X Pareto-dominates Y if someone prefers X and nobody prefers Y.",
     "anchor": "local-remediation-voting-rules-strategyproofness-pareto-p03"
    }
   ],
   "recall": [
    {
     "id": "local-remediation-voting-rules-strategyproofness-pareto-r1",
     "question": "What does Gibbard-Satterthwaite say?",
     "answer": "With 3+ outcomes, no non-dictatorial deterministic rule is strategyproof.",
     "anchor": "local-remediation-voting-rules-strategyproofness-pareto-p02"
    },
    {
     "id": "local-remediation-voting-rules-strategyproofness-pareto-r2",
     "question": "What is Pareto efficiency?",
     "answer": "The chosen outcome is not dominated.",
     "anchor": "local-remediation-voting-rules-strategyproofness-pareto-p03"
    }
   ]
  },
  {
   "anchor": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle",
   "title": "Russian-doll ladder for the major mechanism (the Condorcet cycle)",
   "minutes": 1,
   "endAnchor": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "cycle",
     "definition": "A>B>C>A with no winner; majority is pairwise, not global.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle-list01"
    },
    {
     "term": "majority rule",
     "definition": "Pairwise, not global; it can contradict itself.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle-list01"
    },
    {
     "term": "tournament",
     "definition": "Compute the three margins; implement the tournament.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle-list01"
    }
   ],
   "recall": [
    {
     "id": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle-r1",
     "question": "What breaks the cycle?",
     "answer": "Adding two A>B>C ballots: margins +3, +3, +1, transitive A>B>C.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle-list01"
    },
    {
     "id": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle-r2",
     "question": "How often do cycles occur in random profiles?",
     "answer": "0.081 here, by simulation.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-the-condorcet-cycle-list01"
    }
   ]
  },
