    },
    {
     "anchor": "cs329h-u09-c05-strategic-reports-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "strategic voting",
     "definition": "A game: each ballot is a move, the rule maps ballots to outcomes, voters maximize their own outcome.",
     "anchor": "cs329h-u09-c05-strategic-reports-p01"
    },
    {
     "term": "dominant",
     "definition": "Voter 0 has a strictly dominant strategic move.",
     "anchor": "cs329h-u09-c05-strategic-reports-p05"
    },
    {
     "term": "Nash",
     "definition": "Voter 0 strategic.",
     "anchor": "cs329h-u09-c05-strategic-reports-p06"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u09-c05-strategic-reports-r1",
     "question": "What are the game payoffs?",
     "answer": "(sincere, sincere) -> B, payoffs (1, 0); voter 0 strategic -> A, payoffs (0, 1).",
     "anchor": "cs329h-u09-c05-strategic-reports-p05"
    },
    {
     "id": "cs329h-u09-c05-strategic-reports-r2",
     "question": "When does the 'equilibrium' never occur?",
     "answer": "When common knowledge fails and voter 0 strategizes against a phantom.",
     "anchor": "cs329h-u09-c05-strategic-reports-p11"
    }
   ]
  },
