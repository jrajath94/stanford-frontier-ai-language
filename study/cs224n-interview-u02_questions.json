  {
   "anchor": "breadth-b1-b6",
   "title": "Breadth (B1-B6)",
   "minutes": 1,
   "endAnchor": "breadth-b1-b6-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "one-hot",
     "definition": "A V-long vector with one 1; similarity breaks on it.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "distributed representations",
     "definition": "Dense vectors where similarity works.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "skip-gram",
     "definition": "Predicts context from the center word.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "CBOW",
     "definition": "Predicts the center word from context.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "negative sampling",
     "definition": "Trains on k negatives per pair; avoids the full softmax.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "GloVe",
     "definition": "Factorizes cooccurrence counts with a weighting function f.",
     "anchor": "breadth-b1-b6-p01"
    }
   ],
   "recall": [
    {
     "id": "breadth-b1-b6-r1",
     "question": "What two objectives must B2 state?",
     "answer": "Skip-gram and CBOW, and the direction each predicts.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "id": "breadth-b1-b6-r2",
     "question": "What cost does B3's objective avoid?",
     "answer": "The full softmax.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "id": "breadth-b1-b6-r3",
     "question": "What does B6 ask in one sentence?",
     "answer": "The Levy-Goldberg result: what matrix skip-gram factorizes.",
     "anchor": "breadth-b1-b6-p01"
    }
   ]
  },
  {
   "anchor": "deep-ladder-1-from-counts-to-vectors-d11-d15",
   "title": "Deep ladder 1 , from counts to vectors (D1.1-D1.5)",
   "minutes": 1,
   "endAnchor": "deep-ladder-1-from-counts-to-vectors-d11-d15-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "distributional hypothesis",
     "definition": "Words in similar contexts have similar meanings.",
     "anchor": "deep-ladder-1-from-counts-to-vectors-d11-d15-p01"
    },
    {
     "term": "66 pairs",
     "definition": "The (center, context) count for 18 tokens at window 2.",
     "anchor": "deep-ladder-1-from-counts-to-vectors-d11-d15-p01"
    },
    {
     "term": "noise distribution",
     "definition": "Where the D1.4 diagnosis starts.",
     "anchor": "deep-ladder-1-from-counts-to-vectors-d11-d15-p01"
    },
    {
     "term": "streaming corpus",
     "definition": "A corpus that never ends; GloVe's cooccurrence table breaks on it.",
     "anchor": "deep-ladder-1-from-counts-to-vectors-d11-d15-p01"
    }
   ],
   "recall": [
    {
     "id": "deep-ladder-1-from-counts-to-vectors-d11-d15-r1",
     "question": "What does D1.2 ask, and why 66?",
     "answer": "How many (center, context) pairs for 18 tokens at window 2, and why 66.",
     "anchor": "deep-ladder-1-from-counts-to-vectors-d11-d15-p01"
    },
    {
     "id": "deep-ladder-1-from-counts-to-vectors-d11-d15-r2",
     "question": "What symptom does D1.4 report?",
     "answer": "All pair cosines sit near 0.9 after training on 35 raw tokens.",
     "anchor": "deep-ladder-1-from-counts-to-vectors-d11-d15-p01"
    }
   ]
  },
  {
   "anchor": "deep-ladder-2-evaluation-and-limits-d21-d25",
   "title": "Deep ladder 2 , evaluation and limits (D2.1-D2.5)",
   "minutes": 1,
   "endAnchor": "deep-ladder-2-evaluation-and-limits-d21-d25-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "intrinsic evaluation",
     "definition": "Judging vectors directly, e.g. analogies.",
     "anchor": "deep-ladder-2-evaluation-and-limits-d21-d25-p01"
    },
    {
     "term": "extrinsic evaluation",
     "definition": "Judging vectors on a downstream task.",
     "anchor": "deep-ladder-2-evaluation-and-limits-d21-d25-p01"
    },
    {
     "term": "exclusion rule",
     "definition": "The analogy rule whose absence returns 'woman' at cosine 1.0.",
     "anchor": "deep-ladder-2-evaluation-and-limits-d21-d25-p01"
    },
    {
     "term": "polysemous",
     "definition": "One word, several senses; its neighbor list mixes them.",
     "anchor": "deep-ladder-2-evaluation-and-limits-d21-d25-p01"
    }
   ],
   "recall": [
    {
     "id": "deep-ladder-2-evaluation-and-limits-d21-d25-r1",
     "question": "What does D2.2 ask you to explain?",
     "answer": "Why the analogy returns 'woman' at cosine 1.0 without the exclusion rule.",
     "anchor": "deep-ladder-2-evaluation-and-limits-d21-d25-p01"
    },
    {
     "id": "deep-ladder-2-evaluation-and-limits-d21-d25-r2",
     "question": "What two counterarguments does D2.5 want?",
     "answer": "Against '80% on analogies means we capture meaning'.",
     "anchor": "deep-ladder-2-evaluation-and-limits-d21-d25-p01"
    }
   ]
  },
  {
   "anchor": "analytical-quantitative-q1-q2",
   "title": "Analytical / quantitative (Q1-Q2)",
   "minutes": 1,
   "endAnchor": "analytical-quantitative-q1-q2-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "multiply-adds",
     "definition": "The per-pair cost comparison: O(V d) versus O(k d).",
     "anchor": "analytical-quantitative-q1-q2-p01"
    },
    {
     "term": "PMI",
     "definition": "Pointwise mutual information; 1.569 nats for (cat, sat).",
     "anchor": "analytical-quantitative-q1-q2-p01"
    },
    {
     "term": "optimum gap",
     "definition": "How far u_sat . v_cat = 0.30 sits from the target.",
     "anchor": "analytical-quantitative-q1-q2-p01"
    }
   ],
   "recall": [
    {
     "id": "analytical-quantitative-q1-q2-r1",
     "question": "What ratio does Q1 ask for?",
     "answer": "Full softmax versus negative sampling multiply-adds per pair.",
     "anchor": "analytical-quantitative-q1-q2-p01"
    },
    {
     "id": "analytical-quantitative-q1-q2-r2",
     "question": "What numbers does Q2 give?",
     "answer": "PMI(cat, sat) = 1.569 nats, k = 2, dot = 0.30.",
     "anchor": "analytical-quantitative-q1-q2-p01"
    }
   ]
  },
