  {
   "anchor": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback",
   "title": "Local remediation: posterior sampling, acquisition functions, dueling feedback",
   "minutes": 1,
   "endAnchor": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "posterior sampling",
     "definition": "Sample theta from the posterior, then act optimally for the sample.",
     "anchor": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback-p01"
    },
    {
     "term": "acquisition functions",
     "definition": "Score each candidate query by expected usefulness; UCB, EI, and PI are examples.",
     "anchor": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback-p02"
    },
    {
     "term": "dueling feedback",
     "definition": "Observe only which of two arms wins, never a numeric reward.",
     "anchor": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback-p03"
    }
   ],
   "recall": [
    {
     "id": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback-r1",
     "question": "What is probability matching?",
     "answer": "P(action) = P(action is optimal); uncertainty becomes exploration with no tuning knob.",
     "anchor": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback-p01"
    },
    {
     "id": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback-r2",
     "question": "How much information is in one duel?",
     "answer": "One bit.",
     "anchor": "local-remediation-posterior-sampling-acquisition-functions-dueling-feedback-p03"
    }
   ]
  },
  {
   "anchor": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling",
   "title": "Russian-doll ladder for the major mechanism (Thompson sampling)",
   "minutes": 1,
   "endAnchor": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "probability matching",
     "definition": "Uncertain arms are sampled in proportion to their chance of being best.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-list01"
    },
    {
     "term": "Beta-Bernoulli update",
     "definition": "The implemented update; run T = 300, seed 23.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-list01"
    },
    {
     "term": "sublinear",
     "definition": "Cumulative regret grows sublinearly; the best arm dominates pulls late.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-list01"
    },
    {
     "term": "non-stationary arms",
     "definition": "The counterexample where the posterior concentrates on stale history.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-list01"
    }
   ],
   "recall": [
    {
     "id": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-r1",
     "question": "What does shell 6 predict?",
     "answer": "Prior Beta(10,10) gives slower learning.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-list01"
    },
    {
     "id": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-r2",
     "question": "What does TS need in production?",
     "answer": "A posterior that samples fast.",
     "anchor": "russian-doll-ladder-for-the-major-mechanism-thompson-sampling-list01"
    }
   ]
  },
