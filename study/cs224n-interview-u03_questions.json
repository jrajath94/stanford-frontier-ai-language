  {
   "anchor": "breadth-b1-b6",
   "title": "Breadth (B1-B6)",
   "minutes": 1,
   "endAnchor": "breadth-b1-b6-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "computational graph",
     "definition": "Nodes are ops; edges carry tensors.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "topological order",
     "definition": "What guarantees correct forward and backward passes.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "stable softmax",
     "definition": "Subtract the max first; the one-line NaN fix.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "vector chain rule",
     "definition": "The rule reverse mode applies without forming the Jacobian.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "reverse mode",
     "definition": "Backprop; it never forms the full Jacobian.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "term": "2-layer ReLU net",
     "definition": "Solves the toy task where a linear model sits at 0.5.",
     "anchor": "breadth-b1-b6-p01"
    }
   ],
   "recall": [
    {
     "id": "breadth-b1-b6-r1",
     "question": "What breaks if you switch reduction mid-training?",
     "answer": "The gradient scale; B2 asks what changes and what breaks.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "id": "breadth-b1-b6-r2",
     "question": "What does B4 ask about repeated word ids?",
     "answer": "What the backward pass does for a batch with a repeated word id.",
     "anchor": "breadth-b1-b6-p01"
    },
    {
     "id": "breadth-b1-b6-r3",
     "question": "What contrast does B6 ask for?",
     "answer": "A 2-layer ReLU net versus a linear model on the toy task.",
     "anchor": "breadth-b1-b6-p01"
    }
   ]
  },
  {
   "anchor": "deep-ladder-1-from-graph-to-gradients-d11-d15",
