   "keyTerms": [
    {
     "term": "comparable scales",
     "definition": "Aggregating cardinal utilities needs them.",
     "anchor": "cs329h-u09-c06-interpersonal-comparison-p01"
    },
    {
     "term": "common scale",
     "definition": "Without it the comparison is meaningless.",
