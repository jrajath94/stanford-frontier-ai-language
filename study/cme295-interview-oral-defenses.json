   "minutes": 1,
   "endAnchor": "d9-masked-diffusion-end",
   "blocks": [],
   "keyTerms": [
    {
     "term": "mask schedule",
     "definition": "Which tokens unmask at each diffusion step.",
     "anchor": "d9-masked-diffusion-list01"
    },
    {
     "term": "per-step cost",
     "definition": "The cost of one diffusion decode step.",
     "anchor": "d9-masked-diffusion-list01"
    },
    {
     "term": "steps-vs-quality",
     "definition": "The experiment trading step count against quality.",
     "anchor": "d9-masked-diffusion-list01"
    }
   ],
   "recall": [
