  {
   "anchor": "cs329h-u07-c06-winner-probability",
   "title": "cs329h-U07-C06: winner probability",
   "minutes": 2,
   "endAnchor": "cs329h-u07-c06-winner-probability-end",
   "blocks": [
    {
     "anchor": "cs329h-u07-c06-winner-probability-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "cs329h-u07-c06-winner-probability-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    },
    {
     "anchor": "cs329h-u07-c06-winner-probability-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "winner probability",
     "definition": "P(i beats j) = E[sigma(s_i - s_j)], averaged over the posterior.",
     "anchor": "cs329h-u07-c06-winner-probability-p03"
    },
    {
     "term": "Jensen",
     "definition": "E[sigma(gap)] != sigma(E[gap]); uncertainty widens probabilities toward 0.5.",
     "anchor": "cs329h-u07-c06-winner-probability-p05"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u07-c06-winner-probability-r1",
     "question": "Plug-in versus averaged on the toy?",
     "answer": "P(1 beats 2): 0.599 plug-in, 0.5930 averaged. P(1 beats 4): 0.846 plug-in, 0.8360 averaged.",
     "anchor": "cs329h-u07-c06-winner-probability-p06"
    },
    {
     "id": "cs329h-u07-c06-winner-probability-r2",
     "question": "When is the average confidently wrong?",
     "answer": "When the posterior misses the true strength entirely, e.g. centered at the wrong sign.",
     "anchor": "cs329h-u07-c06-winner-probability-p11"
    }
   ]
  },
