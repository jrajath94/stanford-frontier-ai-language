  {
   "anchor": "cs329h-u09-c01-individual-versus-social-ranking",
   "title": "cs329h-U09-C01: individual versus social ranking",
   "minutes": 2,
   "endAnchor": "cs329h-u09-c01-individual-versus-social-ranking-end",
   "blocks": [
    {
     "anchor": "cs329h-u09-c01-individual-versus-social-ranking-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "cs329h-u09-c01-individual-versus-social-ranking-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    },
    {
     "anchor": "cs329h-u09-c01-individual-versus-social-ranking-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "social ranking",
     "definition": "The output of a rule; 'the group want' is undefined without the rule.",
     "anchor": "cs329h-u09-c01-individual-versus-social-ranking-p03"
    },
    {
     "term": "individual rankings",
     "definition": "Inputs; the rule maps them to the social ranking.",
     "anchor": "cs329h-u09-c01-individual-versus-social-ranking-p03"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u09-c01-individual-versus-social-ranking-r1",
     "question": "What do the three rules give on the toy?",
     "answer": "Plurality 1-1-1 tie, Borda 3-3-3 tie, Condorcet no winner.",
     "anchor": "cs329h-u09-c01-individual-versus-social-ranking-p05"
    },
    {
     "id": "cs329h-u09-c01-individual-versus-social-ranking-r2",
     "question": "When is the rule choice corrupt?",
     "answer": "When the rule is chosen after seeing the ballots to favor a candidate.",
     "anchor": "cs329h-u09-c01-individual-versus-social-ranking-p11"
    }
   ]
  },
  {
   "anchor": "cs329h-u09-c02-arrow-assumptions",
   "title": "cs329h-U09-C02: Arrow assumptions",
   "minutes": 2,
   "endAnchor": "cs329h-u09-c02-arrow-assumptions-end",
   "blocks": [
    {
     "anchor": "cs329h-u09-c02-arrow-assumptions-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "cs329h-u09-c02-arrow-assumptions-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    },
    {
     "anchor": "cs329h-u09-c02-arrow-assumptions-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "Arrow",
     "definition": "With 3+ candidates, no ranked voting rule satisfies unrestricted domain, Pareto, IIA, and non-dictatorship.",
     "anchor": "cs329h-u09-c02-arrow-assumptions-p01"
    },
    {
     "term": "dictator",
     "definition": "The swing voter that IIA + Pareto force to be decisive on all pairs.",
     "anchor": "cs329h-u09-c02-arrow-assumptions-p05"
    },
    {
     "term": "spoiler",
     "definition": "D enters, loses pairwise to B 2-7, yet plurality flips from A to B.",
     "anchor": "cs329h-u09-c02-arrow-assumptions-p02"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u09-c02-arrow-assumptions-r1",
     "question": "What are Arrow's four conditions?",
     "answer": "Unrestricted domain, Pareto, IIA, non-dictatorship.",
     "anchor": "cs329h-u09-c02-arrow-assumptions-p03"
    },
    {
     "id": "cs329h-u09-c02-arrow-assumptions-r2",
     "question": "How does the spoiler violate IIA?",
     "answer": "Without D, plurality elects A (4-3-2). D enters, loses, yet plurality flips to B.",
     "anchor": "cs329h-u09-c02-arrow-assumptions-p06"
    }
   ]
  },
  {
   "anchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions",
   "title": "cs329h-U09-C03: Gibbard-Satterthwaite assumptions",
   "minutes": 2,
   "endAnchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-end",
   "blocks": [
    {
     "anchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    },
    {
     "anchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "Gibbard-Satterthwaite",
     "definition": "With 3+ outcomes, every non-dictatorial deterministic rule is manipulable.",
     "anchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-p03"
    },
    {
     "term": "manipulable",
     "definition": "Some voter can profit by lying.",
     "anchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-p03"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-r1",
     "question": "How does voter 0 manipulate Borda?",
     "answer": "True A>B>C; reports A>C>B, moving the outcome from B to A.",
     "anchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-p05"
    },
    {
     "id": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-r2",
     "question": "What contradicts GS?",
     "answer": "Any 'strategyproof' claim for a deterministic rule with 3+ outcomes.",
     "anchor": "cs329h-u09-c03-gibbard-satterthwaite-assumptions-p11"
    }
   ]
  },
  {
   "anchor": "cs329h-u09-c04-cycles",
   "title": "cs329h-U09-C04: cycles",
   "minutes": 2,
   "endAnchor": "cs329h-u09-c04-cycles-end",
   "blocks": [
    {
     "anchor": "cs329h-u09-c04-cycles-p03",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "cs329h-u09-c04-cycles-p05",
     "kind": "keyIdea",
     "reveal": "fade"
    },
    {
     "anchor": "cs329h-u09-c04-cycles-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "Condorcet cycle",
     "definition": "A beats B, B beats C, C beats A, all by majority; no Condorcet winner exists.",
     "anchor": "cs329h-u09-c04-cycles-p01"
    },
    {
     "term": "agenda",
     "definition": "The vote order; voting A-vs-B first then winner vs C lets C win the tournament.",
     "anchor": "cs329h-u09-c04-cycles-p05"
    }
   ],
   "recall": [
    {
     "id": "cs329h-u09-c04-cycles-r1",
     "question": "What are the cycle margins?",
     "answer": "A>B +1, B>C +1, C>A +1 (2-1 each); adding two A>B>C ballots gives +3, +3, +1.",
     "anchor": "cs329h-u09-c04-cycles-p06"
    },
    {
     "id": "cs329h-u09-c04-cycles-r2",
     "question": "Who picks when there is no Condorcet winner?",
     "answer": "The procedure, not the voters.",
     "anchor": "cs329h-u09-c04-cycles-p11"
    }
   ]
  },
  {
   "anchor": "cs329h-u09-c05-strategic-reports",
   "title": "cs329h-U09-C05: strategic reports",
   "minutes": 2,
   "endAnchor": "cs329h-u09-c05-strategic-reports-end",
   "blocks": [
    {
     "anchor": "cs329h-u09-c05-strategic-reports-p03",
